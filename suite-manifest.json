    "canonical_policy": "shared/references/content-qa-policy.md",
    "complete_slide_index": "shared/references/content-qa-full-slide-index.md",
    "slide_inventory": "shared/references/content-qa-slide-inventory.json",
    "control_register": "shared/references/content-qa-control-register.json",
    "slide_count": 97,
    "source_sha256": "ec8dc8025e76e2232951a099ad32e5a73890a5687ba8fbefd497c41271ddebe5",
    "source_requires_full_coverage": true,
    "missing_source_gate": "CONTENT_QA_SOURCE_INCOMPLETE"
