  "editorial_notes_policy": "shared/references/editorial-notes-all-resources.md",
  "editorial_notes_auditor": "skills/template-format-reviewer/scripts/audit_editorial_notes.py",
  "editorial_notes_scope": "all_resource_types",
  "editorial_notes_target_words": "20-45",
  "editorial_notes_max_words": 60,
  "editorial_notes_images_location": "Contenido del Recurso; never in Notas de Edición",
  "video_timecodes_policy": "allowed_only_for_sync_cues",
  "rise_timecodes_policy": "prohibited_except_approved_sync",
  "editorial_stock_enforcement_policy": "shared/references/editorial-stock-enforcement.md",
  "canonical_editorial_contract": "qa/R##.editorial-contract.json",
  "stock_search_log": "qa/R##.stock-search-log.json",
  "editorial_contract_script": "shared/scripts/editorial_contract.py",
  "stock_search_gate": "shared/scripts/audit_stock_execution.py",
  "quality_gate_runner": "shared/scripts/run_quality_gates.py",
  "stock_required_without_search": "red_not_ready",
  "stock_no_match_or_access_blocked": "implementation_pending_not_ready",
