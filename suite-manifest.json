    "source-fidelity-reviewer",
    "template-format-reviewer",
    "visual-stock-reviewer"
  ],
  "default_output": "local_docx",
  "remote_upload": "explicit_user_request_only",
  "auto_fix_cycles_max": 2,
  "writing_guide": {
    "name": "Content - Revisión QA x DI.pptx",
