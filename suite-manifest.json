    "Contenido del Recurso"
  ],
  "source_traceability_policy": "external_qa_files_only",
  "word_delivery_contract": "shared/references/word-delivery-contract.md",
  "visual_policy": "shared/references/visual-language-and-stock-policy.md",
  "visual_plan_auditor": "skills/visual-stock-reviewer/scripts/audit_visual_plan.py",
  "video_stock_link_policy": "real_external_clickable_hyperlink_in_editorial_docx_or_pending_not_ready",
  "rise_tabs_accordion_visual_policy": "visual_decision_per_panel_or_justified_exception",
  "installer_update_policy": "same_project_directory_backup_existing_suite_only",
  "rise_editorial_reference": "shared/references/rise-editorial-reference.md",
  "rise_notes_target_words": "20-45",
  "rise_notes_max_words": 60,
  "rise_visual_location": "Contenido del Recurso (right editorial column)",
